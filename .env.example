# Required runtime site origin; email links never use the request Host.
PIONEER_SITE_URL=https://wiki.perlica.cloud
# Enable only behind a proxy that overwrites X-Real-IP; keep the app port private.
PIONEER_TRUST_PROXY=1
# Generate with: openssl rand -hex 32 (stable across application replicas).
PIONEER_THROTTLE_SECRET=
# Preferred server-only aliases; NEXT_PUBLIC_* below remain compatible.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Supabase project settings. Keep the service-role key server-only if you add one later.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: comma-separated emails promoted to admin by the bootstrap SQL/script.
PIONEER_ADMIN_EMAILS=you@example.com
# Only for the one-time bootstrap script; never expose this with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Leave unset to use Supabase when the public settings above are present; use mock to force local fixtures.
# PIONEER_DATA_SOURCE=mock
# SUPABASE_SERVICE_ROLE_KEY is required only for migrations/seed/bootstrap commands.

# Read by docker compose from .env on a deployment host (see deploy/DEPLOY.txt); ignored elsewhere.
# PIONEER_IMAGE=pioneer-wiki:latest      # roll back with pioneer-wiki:<tag>
# PIONEER_BIND=127.0.0.1                 # the host's Caddy proxies to this
# PIONEER_PORT=3000

# Image pipeline for tools/gen-images.mjs and tools/edit-image.mjs (never needed at runtime).
# The gateway must expose an OpenAI-compatible POST {PW_IMAGE_BASE_URL}/v1/images/generations
# returning data[0].b64_json or data[0].url. PW_IMAGE_MODEL defaults to gpt-image-2.
# PW_IMAGE_BASE_URL=https://your-gateway.example.com
# PW_IMAGE_API_KEY=your-image-key
# PW_IMAGE_MODEL=gpt-image-2

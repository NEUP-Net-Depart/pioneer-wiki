{
  "name": "pioneer-wiki",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "description": "Pioneer Wiki · 先锋维基 — a bilingual natural history of computer science",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"tools/**/*.{js,mjs,ts,json}\" .prettierrc.json components.json eslint.config.mjs next.config.ts package.json postcss.config.mjs tsconfig.json vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"tools/**/*.{js,mjs,ts,json}\" .prettierrc.json components.json eslint.config.mjs next.config.ts package.json postcss.config.mjs tsconfig.json vitest.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "bootstrap-admin": "node tools/bootstrap-admin.mjs",
    "seed-supabase": "node --experimental-strip-types tools/seed-supabase.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "diff": "^9.0.0",
    "github-slugger": "^2.0.0",
    "ipaddr.js": "^2.2.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.51.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.3.8",
    "parse5": "^7.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-jsdoc": "63.3.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0"
}
